  "fx_algorithms": [
    {
      "index": 1,
      "id": "bell_eq",
      "name": "Bell EQ",
      "description": "A versatile parametric peaking or notch filter with adjustable bandwidth and macro DJ tilt filter.",
      "knobs": [
        "bell_eq_freq",
        "bell_eq_width",
        "bell_eq_gain",
        "bell_eq_djfilter"
      ]
    },
    {
      "index": 2,
      "id": "chorus",
      "name": "Chorus",
      "description": "A lush, multi-voice modulation effect creating a thick, shimmering ensemble sound.",
      "knobs": [
        "chorus_rate",
        "chorus_depth",
        "chorus_feedback",
        "chorus_mix"
      ]
    },
    {
      "index": 3,
      "id": "comb_filter",
      "name": "Comb Filter",
      "description": "A short, resonant delay line that creates metallic, hollow, or flanging acoustic resonances.",
      "knobs": [
        "comb_dampening",
        "comb_cutoff",
        "comb_resonance",
        "comb_mix"
      ]
    },
    {
      "index": 4,
      "id": "drive",
      "name": "Drive",
      "description": "An aggressive nonlinear saturation and distortion unit with asymmetrical clipping and filtering.",
      "knobs": [
        "drive_amount",
        "drive_bias",
        "drive_filter",
        "drive_limiter"
      ]
    },
    {
      "index": 5,
      "id": "fx_filter",
      "name": "FX Filter",
      "description": "A multi-mode resonant filter (Low-pass, Band-pass, High-pass, Notch) with variable slopes.",
      "knobs": [
        "fxfilter_type",
        "fxfilter_slope",
        "fxfilter_cutoff",
        "fxfilter_resonance"
      ]
    },
    {
      "index": 6,
      "id": "flanger",
      "name": "Flanger",
      "description": "A sweeping phase cancellation effect created by mixing a slightly delayed signal with the original.",
      "knobs": [
        "flanger_rate",
        "flanger_depth",
        "flanger_feedback",
        "flanger_mix"
      ]
    },
    {
      "index": 7,
      "id": "frequency_shifter",
      "name": "Frequency Shifter",
      "description": "An advanced modulation effect that shifts all frequencies by a linear amount, destroying harmonic relationships.",
      "knobs": [
        "freqshift_shift",
        "freqshift_range",
        "freqshift_blend",
        "freqshift_width"
      ]
    },
    {
      "index": 8,
      "id": "grit_fx",
      "name": "Grit FX",
      "description": "A digital degradation processor combining bitcrushing, sample rate reduction, and EQ for lo-fi textures.",
      "knobs": [
        "grit_bits",
        "grit_rate",
        "grit_low",
        "grit_high"
      ]
    },
    {
      "index": 9,
      "id": "phase_smear",
      "name": "Phase Smear",
      "description": "A network of all-pass filters that disperses transient energy, creating laser-like 'pew' sweeps and smeared stereo fields.",
      "knobs": [
        "phasesmear_type",
        "phasesmear_amount",
        "phasesmear_cutoff",
        "phasesmear_resonance"
      ]
    },
    {
      "index": 10,
      "id": "phaser",
      "name": "Phaser",
      "description": "A sweeping sequence of all-pass filters creating moving notches and peaks in the frequency spectrum.",
      "knobs": [
        "phaser_rate",
        "phaser_depth",
        "phaser_feedback",
        "phaser_mix"
      ]
    },
    {
      "index": 11,
      "id": "ringmod",
      "name": "RingMod",
      "description": "An amplitude modulator using an internal oscillator, creating dissonant, metallic, or robotic sidebands.",
      "knobs": [
        "ringmod_wave",
        "ringmod_rate",
        "ringmod_amount",
        "ringmod_width"
      ]
    },
    {
      "index": 12,
      "id": "tempo_delay",
      "name": "Tempo Delay",
      "description": "A host-synchronized echo and delay effect with filtering and analog-style regeneration.",
      "knobs": [
        "delay_div",
        "delay_feedback",
        "delay_tone",
        "delay_mix"
      ]
    },
    {
      "index": 13,
      "id": "wave_folder",
      "name": "Wave Folder",
      "description": "A nonlinear distortion that folds waveforms back on themselves when they exceed a threshold, adding rich complex harmonics.",
      "knobs": [
        "wavefolder_limiter",
        "wavefolder_fold",
        "wavefolder_bias",
        "wavefolder_filter"
      ]
    }
  ],
