#!/bin/bash
# ==============================================================================
# The Klang Farmer & The Klang Planter - macOS Installer Postinstall Script
# Strips Gatekeeper quarantine flags and refreshes the CoreAudio AU cache.
# ==============================================================================

echo "Removing quarantine attributes from installed plugins and apps..."
xattr -rd com.apple.quarantine "/Library/Audio/Plug-Ins/VST3/The Klang Farmer.vst3" 2>/dev/null || true
xattr -rd com.apple.quarantine "/Library/Audio/Plug-Ins/Components/The Klang Farmer.component" 2>/dev/null || true
xattr -rd com.apple.quarantine "/Library/Audio/Plug-Ins/VST3/The Klang Planter.vst3" 2>/dev/null || true
xattr -rd com.apple.quarantine "/Library/Audio/Plug-Ins/Components/The Klang Planter.component" 2>/dev/null || true
xattr -rd com.apple.quarantine "/Applications/The Klang Farmer.app" 2>/dev/null || true
xattr -rd com.apple.quarantine "/Applications/The Klang Planter.app" 2>/dev/null || true
xattr -rd com.apple.quarantine "/Applications/The Klang Editor.app" 2>/dev/null || true

# Refresh CoreAudio and AudioComponentRegistrar so DAWs scan plugins immediately
echo "Refreshing AudioComponentRegistrar and CoreAudio daemons..."
killall -9 AudioComponentRegistrar 2>/dev/null || true
killall -9 coreaudiod 2>/dev/null || true

exit 0
